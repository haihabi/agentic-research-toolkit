# Required: Overleaf personal or per-project git token.
# Overleaf -> Account Settings -> Git integration (personal token, works across
# all your projects), or a project's Menu -> Git (per-project token).
# Requires a paid Overleaf plan / institutional licence with git enabled.
OVERLEAF_GIT_TOKEN=

# Optional: where cloned projects live.
# Default: platform data dir, e.g. ~/Library/Application Support/overleaf-mcp (macOS).
# OVERLEAF_MCP_WORKSPACE=

# Optional: identity stamped on the commits this server creates.
# OVERLEAF_MCP_GIT_NAME=overleaf-mcp
# OVERLEAF_MCP_GIT_EMAIL=overleaf-mcp@localhost

# Optional: reject binary reads/writes larger than this many MB.
# OVERLEAF_MCP_MAX_BINARY_MB=25

# Optional: seconds before compile_project gives up.
# OVERLEAF_MCP_COMPILE_TIMEOUT=120
